# 忽略全港 3D 大容量 Zip 及 FBX 模型檔
all_3324_zips/
raw_zips/
extracted_fbx/
downloaded_models/
*.zip
*.fbx
*.obj

# 忽略 Blender 暫存檔
*.blend1
build_mesh.py
api_downloader.py

# 忽略大容量 OSM 原始下載數據 (可重新下載再生)
build/HP1C/source/roads.osm.json
build/HP1C/source/roads.osm.json.gz
build/**/*.osm.json

# Python cache
__pycache__/
*.pyc

# 可再生成嘅 AI spline 中間產物 (content/tracks 先係發布版)
build/HP1C/*/ai/

# 地圖 KN5 (可再生成, 太大唔上傳)
content/tracks/*/hd_map.kn5

# 參考車 (本地參考用, 唔上傳)
build/_ac_reference/

# Sound banks (too large for GitHub, copy from AC or regenerate)
content/cars/*/sfx/*.bank

# Map KN5 build artifacts (regenerable, too large)
build/HP1C/*/hd_map.kn5
